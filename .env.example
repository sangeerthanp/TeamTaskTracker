AZURE_ORG=your-azure-devops-org
AZURE_PAT=your-azure-devops-personal-access-token
PORT=3000

# JSON array, one entry per team member: { name, email }. name must match the
# person's full display name exactly as it appears in Azure DevOps' Assigned
# To field (case-sensitive) - it's still used to build the query, just paired
# with email now so two people sharing a display name aren't merged together.
#
# IMPORTANT: email must be the identity value Azure DevOps itself returns for
# that person (the AssignedTo field's uniqueName) - NOT necessarily their real
# company email address. Some orgs' Azure DevOps identities use short internal
# aliases (e.g. "jdoe@contoso.com") that differ from the person's actual
# corporate email/UPN used to sign in elsewhere. Guessing the wrong value here
# fails silently: that person's tickets just won't match anything. To find the
# correct value, open any of their existing work items and check the
# AssignedTo field via the API (GET .../_apis/wit/workitems/{id}?api-version=7.1
# and read fields."System.AssignedTo".uniqueName), or start typing their name
# into the Assigned To box in the Azure DevOps UI and see what it resolves to.
TEAM_MEMBERS=[{"name":"Jane Doe","email":"jane.doe@example.com"},{"name":"John Smith","email":"john.smith@example.com"}]

# JSON array, one entry per dashboard project. id is the value used in the
# frontend/API (?project=<id>); name is shown in the UI; azureProject is the
# exact Azure DevOps project name; areaPath is the area path to scope tickets
# to (use double backslashes to separate segments in JSON).
PROJECTS_CONFIG=[{"id":"project-a","name":"Project A","azureProject":"Project A","areaPath":"Project A\\Team"},{"id":"project-b","name":"Project B","azureProject":"Project B Azure Name","areaPath":"Project B Azure Name\\Team"}]
